HOLDED_WEBHOOK_SECRET=whsec_your_secret_here
WINK_API_KEY=your_wink_api_key_here
WINK_INVENTORY_IDS=12

# Comma-separated Holded stock.update actions to forward to Wink. Any action
# not listed here is skipped, including unknown ones, so the list fails closed.
#
# A Wink sale already lowers Wink stock, and approving the sales receipt that
# wink-sale-integration created in Holded lowers Holded stock too. Forwarding
# that second movement deducts the units twice, which is what this prevents.
#
# Holded documents only two action names (invoice_stock_update,
# manual_stock_update), so the list below is a starting point, not a verified
# one. Confirm the real values before enabling it in production: the Lambda logs
# action, description and the origin fields on every stock.update, so one test
# sale in CloudWatch is enough to enumerate them. Add any other movement you
# want mirrored; leave out anything document-driven.
HOLDED_STOCK_SYNC_ACTIONS=manual_stock_update
